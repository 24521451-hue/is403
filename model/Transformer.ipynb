    "# 1. Đọc dữ liệu từ Apple_Stock_ready.csv\n",
    "CANDIDATE_PATHS = [\n",
    "    \"Apple_Stock_ready.csv\",\n",
    "    \"Cleaned data/Apple_Stock_ready.csv\",\n",
    "    \"../Cleaned data/Apple_Stock_ready.csv\",\n",
    "    r\"c:\\Users\\Admin\\Downloads\\is403-main\\is403-main\\Cleaned data\\Apple_Stock_ready.csv\",\n",
    "    \"../is403-main/is403-main/Cleaned data/Apple_Stock_ready.csv\"\n",
    "]\n",
    "DATA_PATH = next((p for p in CANDIDATE_PATHS if os.path.exists(p)), CANDIDATE_PATHS[0])\n",
    "df = pd.read_csv(DATA_PATH).rename(columns={\"NextPrice\": \"nextPrice\"})\n",
    "df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n",
    "df = df.sort_values(\"Date\").reset_index(drop=True)\n",
    "\n",
    "# Tạo biến mục tiêu mô hình học: delta = nextPrice - Price\n",
    "df[\"delta\"] = df[\"nextPrice\"] - df[\"Price\"]\n",
    "\n",
    "# Kiểm định tính toàn vẹn dữ liệu & chống rò rỉ (Data Leakage Check)\n",
    "missing_cnt = int(df.isna().sum().sum())\n",
    "dup_dates   = int(df[\"Date\"].duplicated().sum())\n",
    "shift_diff  = float(np.max(np.abs(df[\"nextPrice\"].iloc[:-1].values - df[\"Price\"].iloc[1:].values)))\n",
    "collinear_r = float(np.corrcoef(df[\"Return_1\"], df[\"Change_Pct\"])[0, 1])\n",
    "\n",
    "print(f\"Đường dẫn dữ liệu                  : {DATA_PATH}\")\n",
    "print(f\"Kích thước dữ liệu                 : {df.shape[0]} dòng x {df.shape[1]} cột (bao gồm cột delta)\")\n",
    "print(f\"Khoảng thời gian                   : {df['Date'].min().strftime('%Y-%m-%d')} -> {df['Date'].max().strftime('%Y-%m-%d')}\")\n",
    "print(f\"Số giá trị thiếu (NaN) / Ngày trùng: {missing_cnt} / {dup_dates}\")\n",
    "print(f\"Sai số kiểm tra nextPrice[t]=P[t+1]: {shift_diff:.6f}\")\n",
    "print(f\"Tương quan Return_1 vs Change_Pct  : r = {collinear_r:.6f} (Loại bỏ Change_Pct theo mục 2.3 README.md)\")\n",
    "\n",
    "# 2. Chia tập dữ liệu theo đúng thứ tự thời gian (80% Train / 20% Test; Train chia 90% Fit / 10% Val)\n",
    "N = len(df)\n",
    "n_train = int(N * 0.80)        # 3.216 dòng\n",
    "n_fit   = int(n_train * 0.90)  # 2.894 dòng\n",
    "\n",
    "train_df     = df.iloc[:n_train].copy()\n",
    "test_df      = df.iloc[n_train:].copy()\n",
    "train_fit_df = train_df.iloc[:n_fit].copy()\n",
    "train_val_df = train_df.iloc[n_fit:].copy()\n",
    "\n",
    "pct_test_above_train = float(np.mean(test_df[\"Price\"] > train_df[\"Price\"].max()) * 100.0)\n",
    "\n",
    "split_summary = pd.DataFrame([\n",
    "    {\n",
    "        \"Tập dữ liệu\": \"train_fit (72%)\",\n",
    "        \"Số dòng\": len(train_fit_df),\n",
    "        \"Từ ngày\": train_fit_df[\"Date\"].min().strftime(\"%Y-%m-%d\"),\n",
    "        \"Đến ngày\": train_fit_df[\"Date\"].max().strftime(\"%Y-%m-%d\"),\n",
    "        \"Price Min ($)\": round(train_fit_df[\"Price\"].min(), 2),\n",
    "        \"Price Mean ($)\": round(train_fit_df[\"Price\"].mean(), 2),\n",
    "        \"Price Max ($)\": round(train_fit_df[\"Price\"].max(), 2),\n",
    "        \"Delta Mean ($)\": round(train_fit_df[\"delta\"].mean(), 4),\n",
    "        \"Delta Std ($)\": round(train_fit_df[\"delta\"].std(), 4),\n",
    "    },\n",
    "    {\n",
    "        \"Tập dữ liệu\": \"train_val (8%)\",\n",
    "        \"Số dòng\": len(train_val_df),\n",
    "        \"Từ ngày\": train_val_df[\"Date\"].min().strftime(\"%Y-%m-%d\"),\n",
    "        \"Đến ngày\": train_val_df[\"Date\"].max().strftime(\"%Y-%m-%d\"),\n",
    "        \"Price Min ($)\": round(train_val_df[\"Price\"].min(), 2),\n",
    "        \"Price Mean ($)\": round(train_val_df[\"Price\"].mean(), 2),\n",
    "        \"Price Max ($)\": round(train_val_df[\"Price\"].max(), 2),\n",
    "        \"Delta Mean ($)\": round(train_val_df[\"delta\"].mean(), 4),\n",
    "        \"Delta Std ($)\": round(train_val_df[\"delta\"].std(), 4),\n",
    "    },\n",
    "    {\n",
    "        \"Tập dữ liệu\": \"test (20%)\",\n",
    "        \"Số dòng\": len(test_df),\n",
    "        \"Từ ngày\": test_df[\"Date\"].min().strftime(\"%Y-%m-%d\"),\n",
    "        \"Đến ngày\": test_df[\"Date\"].max().strftime(\"%Y-%m-%d\"),\n",
    "        \"Price Min ($)\": round(test_df[\"Price\"].min(), 2),\n",
    "        \"Price Mean ($)\": round(test_df[\"Price\"].mean(), 2),\n",
    "        \"Price Max ($)\": round(test_df[\"Price\"].max(), 2),\n",
    "        \"Delta Mean ($)\": round(test_df[\"delta\"].mean(), 4),\n",
    "        \"Delta Std ($)\": round(test_df[\"delta\"].std(), 4),\n",
    "    }\n",
    "])\n",
    "print(\"\\n=== THỐNG KÊ PHÂN CHIA TẬP DỮ LIỆU CHUẨN NHÓM 2 ===\")\n",
    "print(split_summary.to_string(index=False))\n",
    "print(f\"-> Tỷ lệ ngày trong tập Test có giá vượt đỉnh lịch sử tập Train ($193.97): {pct_test_above_train:.2f}%\")\n",
