   "source": [
    "class StationaryWindowNormalizer(layers.Layer):\n",
    "    \"\"\"Full RevIN (Kim et al., ICLR 2022): Chuẩn hóa toàn bộ các cột theo từng cửa sổ trượt.\"\"\"\n",
    "    def __init__(self, eps=1e-5, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.eps = eps\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        d = input_shape[-1]\n",
    "        self.gamma = self.add_weight(name=\"gamma\", shape=(1, 1, d), initializer=\"ones\", trainable=True)\n",
    "        self.beta  = self.add_weight(name=\"beta\",  shape=(1, 1, d), initializer=\"zeros\", trainable=True)\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        mean = tf.reduce_mean(x, axis=1, keepdims=True)\n",
    "        std  = tf.math.reduce_std(x, axis=1, keepdims=True) + self.eps\n",
    "        return ((x - mean) / std) * self.gamma + self.beta\n",
    "\n",
    "\n",
    "class SelectiveWindowNormalizer(layers.Layer):\n",
    "    \"\"\"\n",
    "    Selective RevIN: Chỉ chuẩn hóa theo cửa sổ trượt trên 5 đặc trưng mức giá/khối lượng không dừng (cột 0..4:\n",
    "    Price, Open, High, Low, Volume), giữ nguyên điểm 0 (dấu biến động) và biên độ của 3 đặc trưng dừng\n",
    "    (cột 5..7: Return_1, High_Low_Range, Open_Close_Change).\n",
    "    \"\"\"\n",
    "    def __init__(self, non_stat_cols=5, eps=1e-5, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.non_stat_cols = non_stat_cols\n",
    "        self.eps = eps\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        d = input_shape[-1]\n",
    "        self.gamma = self.add_weight(name=\"gamma\", shape=(1, 1, d), initializer=\"ones\", trainable=True)\n",
    "        self.beta  = self.add_weight(name=\"beta\",  shape=(1, 1, d), initializer=\"zeros\", trainable=True)\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        x_non_stat = x[:, :, :self.non_stat_cols]\n",
    "        x_stat     = x[:, :, self.non_stat_cols:]\n",
    "        mean = tf.reduce_mean(x_non_stat, axis=1, keepdims=True)\n",
    "        std  = tf.math.reduce_std(x_non_stat, axis=1, keepdims=True) + self.eps\n",
    "        x_non_stat_norm = (x_non_stat - mean) / std\n",
    "        x_combined = tf.concat([x_non_stat_norm, x_stat], axis=-1)\n",
    "        return x_combined * self.gamma + self.beta\n",
    "\n",
    "\n",
    "class SinusoidalPositionalEncoding(layers.Layer):\n",
    "    \"\"\"Mã hóa vị trí Sinusoidal chuẩn cho chuỗi thời gian.\"\"\"\n",
    "    def __init__(self, max_len, d_model, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        pos = np.arange(max_len)[:, np.newaxis]\n",
    "        div_term = np.exp(np.arange(0, d_model, 2) * -(np.log(10000.0) / d_model))\n",
    "        pe = np.zeros((max_len, d_model), dtype=np.float32)\n",
    "        pe[:, 0::2] = np.sin(pos * div_term)\n",
    "        pe[:, 1::2] = np.cos(pos * div_term[:pe[:, 1::2].shape[1]])\n",
    "        self.pe = tf.constant(pe[np.newaxis, :, :], dtype=tf.float32)\n",
    "\n",
    "    def call(self, x):\n",
    "        return x + self.pe[:, :tf.shape(x)[1], :]\n",
    "\n",
    "\n",
    "class PreLNTransformerEncoderLayer(layers.Layer):\n",
    "    \"\"\"Khối Pre-LayerNorm Transformer Encoder với mặt nạ nhân quả (Causal Self-Attention).\"\"\"\n",
    "    def __init__(self, d_model=64, num_heads=4, ff_dim=128, dropout=0.25, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.norm1 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.mha = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=max(1, d_model // num_heads),\n",
    "            dropout=dropout\n",
    "        )\n",
    "        self.drop1 = layers.Dropout(dropout)\n",
    "        self.norm2 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.ffn = keras.Sequential([\n",
    "            layers.Dense(ff_dim, activation=\"gelu\"),\n",
    "            layers.Dropout(dropout),\n",
    "            layers.Dense(d_model)\n",
    "        ])\n",
    "        self.drop2 = layers.Dropout(dropout)\n",
    "\n",
    "    def call(self, x, training=False):\n",
    "        x_norm = self.norm1(x)\n",
    "        attn_out = self.mha(\n",
    "            query=x_norm, value=x_norm, key=x_norm,\n",
    "            use_causal_mask=True,\n",
    "            training=training\n",
    "        )\n",
    "        x = x + self.drop1(attn_out, training=training)\n",
    "        f_out = self.ffn(self.norm2(x), training=training)\n",
    "        return x + self.drop2(f_out, training=training)\n",
    "\n",
    "    def get_attention_scores(self, x):\n",
    "        x_norm = self.norm1(x)\n",
    "        _, scores = self.mha(\n",
    "            query=x_norm, value=x_norm, key=x_norm,\n",
    "            use_causal_mask=True,\n",
    "            return_attention_scores=True,\n",
    "            training=False\n",
    "        )\n",
    "        return scores\n",
    "\n",
    "\n",
    "class ShrinkageResidualScale(layers.Layer):\n",
    "    \"\"\"Cổng điều tiết biên độ phần dư học được end-to-end: y = x * tanh(alpha).\"\"\"\n",
    "    def __init__(self, init_scale=0.10, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.init_scale = init_scale\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        self.alpha = self.add_weight(\n",
    "            name=\"shrinkage_alpha\",\n",
    "            shape=(1, 1),\n",
    "            initializer=keras.initializers.Constant(self.init_scale),\n",
    "            trainable=True\n",
    "        )\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        return x * tf.nn.tanh(self.alpha)\n",
    "\n",
    "\n",
    "def build_vanilla_transformer(\n",
    "    window_size=30,\n",
    "    num_features=8,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    ff_dim=128,\n",
    "    dropout=0.25\n",
    "):\n",
    "    \"\"\"Mô hình Vanilla Transformer Encoder cơ sở (không có RevIN và không có nhánh Multi-Scale Conv1D).\"\"\"\n",
    "    inputs = keras.Input(shape=(window_size, num_features), name=\"window_input\")\n",
    "    x = layers.Dense(d_model, name=\"input_proj\")(inputs)\n",
    "    x = SinusoidalPositionalEncoding(window_size, d_model, name=\"pos_encoding\")(x)\n",
    "\n",
    "    for i in range(num_layers):\n",
    "        x = PreLNTransformerEncoderLayer(\n",
    "            d_model=d_model, num_heads=num_heads, ff_dim=ff_dim, dropout=dropout,\n",
    "            name=f\"encoder_layer_{i+1}\"\n",
    "        )(x)\n",
    "\n",
    "    context_t = layers.Lambda(lambda z: z[:, -1, :], name=\"last_step_context\")(x)\n",
    "    head = layers.Dropout(dropout, name=\"head_dropout\")(context_t)\n",
    "    head = layers.Dense(32, activation=\"gelu\", kernel_regularizer=keras.regularizers.l2(1e-3), name=\"head_fc\")(head)\n",
    "    outputs = layers.Dense(1, name=\"delta_scaled_pred\")(head)\n",
    "    return keras.Model(inputs=inputs, outputs=outputs, name=\"VanillaTransformer_NoRevIN\")\n",
    "\n",
    "\n",
    "def build_original_parallel_fusion_transformer(\n",
    "    window_size=30,\n",
    "    num_features=8,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    ff_dim=128,\n",
    "    dropout=0.25,\n",
    "    norm_mode=\"full_revin\"\n",
    "):\n",
    "    \"\"\"Mô hình ParallelFusionTransformer phiên bản gốc (Full RevIN + CNN BatchNorm + Zero-Init Head).\"\"\"\n",
    "    inputs = keras.Input(shape=(window_size, num_features), name=\"window_input\")\n",
    "    if norm_mode == \"full_revin\":\n",
    "        x = StationaryWindowNormalizer(name=\"revin_norm\")(inputs)\n",
    "    else:\n",
    "        x = SelectiveWindowNormalizer(non_stat_cols=5, name=\"selective_revin_norm\")(inputs)\n",
    "\n",
    "    branch_k3 = layers.Conv1D(d_model // 4, kernel_size=3, padding=\"causal\", name=\"conv1d_k3\")(x)\n",
    "    branch_k5 = layers.Conv1D(d_model // 4, kernel_size=5, padding=\"causal\", name=\"conv1d_k5\")(x)\n",
    "    branch_k7 = layers.Conv1D(d_model // 4, kernel_size=7, padding=\"causal\", name=\"conv1d_k7\")(x)\n",
    "\n",
    "    cnn_concat = layers.Concatenate(axis=-1, name=\"cnn_multiscale_concat\")([branch_k3, branch_k5, branch_k7])\n",
    "    cnn_act    = layers.Activation(\"gelu\", name=\"cnn_gelu\")(cnn_concat)\n",
    "    cnn_bn     = layers.BatchNormalization(name=\"cnn_bn\")(cnn_act)\n",
    "\n",
    "    linear_branch = layers.Dense(d_model // 4, activation=\"gelu\", name=\"linear_branch\")(x)\n",
    "\n",
    "    fused = layers.Concatenate(axis=-1, name=\"parallel_fusion_concat\")([cnn_bn, linear_branch])\n",
    "    fused = layers.Dense(d_model, name=\"fusion_proj\")(fused)\n",
    "    fused = layers.LayerNormalization(epsilon=1e-6, name=\"fusion_ln\")(fused)\n",
    "\n",
    "    h = SinusoidalPositionalEncoding(window_size, d_model, name=\"pos_encoding\")(fused)\n",
    "    for i in range(num_layers):\n",
    "        h = PreLNTransformerEncoderLayer(\n",
    "            d_model=d_model, num_heads=num_heads, ff_dim=ff_dim, dropout=dropout,\n",
    "            name=f\"encoder_layer_{i+1}\"\n",
    "        )(h)\n",
    "\n",
    "    context_t = layers.Lambda(lambda z: z[:, -1, :], name=\"last_step_context\")(h)\n",
    "    head = layers.Dropout(dropout, name=\"head_dropout\")(context_t)\n",
    "    head = layers.Dense(32, activation=\"gelu\", kernel_regularizer=keras.regularizers.l2(1e-3), name=\"head_fc\")(head)\n",
    "    raw_out = layers.Dense(1, kernel_initializer=\"zeros\", name=\"raw_delta\")(head)\n",
    "    outputs = ShrinkageResidualScale(init_scale=0.15, name=\"delta_scaled_pred\")(raw_out)\n",
    "    return keras.Model(inputs=inputs, outputs=outputs, name=\"OriginalParallelFusionTransformer\")\n",
    "\n",
    "\n",
    "def build_optimized_parallel_fusion_transformer(\n",
    "    window_size=30,\n",
    "    num_features=8,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    ff_dim=128,\n",
    "    dropout=0.25,\n",
    "    init_scale=0.10\n",
    "):\n",
    "    \"\"\"\n",
    "    Mô hình OptimizedParallelFusionTransformer (Phiên bản tối ưu):\n",
    "    1. SelectiveWindowNormalizer: Chỉ chuẩn hóa cửa sổ trên 5 cột không dừng, bảo toàn dấu và biên độ của 3 cột dừng.\n",
    "    2. LayerNormalization (cnn_ln) thay cho BatchNormalization ở nhánh Multi-Scale Causal Conv1D + Final Pre-LN.\n",
    "    3. Khởi tạo RandomNormal(stddev=0.02) ở tầng raw_delta + học End-to-End ShrinkageResidualScale (không dùng post-hoc alpha_opt).\n",
    "    \"\"\"\n",
    "    inputs = keras.Input(shape=(window_size, num_features), name=\"window_input\")\n",
    "    x = SelectiveWindowNormalizer(non_stat_cols=5, name=\"selective_revin_norm\")(inputs)\n",
    "\n",
    "    # 1. Parallel Multi-Scale Feature Extraction Front-End (LayerNorm thay cho BatchNorm)\n",
    "    branch_k3 = layers.Conv1D(d_model // 4, kernel_size=3, padding=\"causal\", name=\"conv1d_k3\")(x)\n",
    "    branch_k5 = layers.Conv1D(d_model // 4, kernel_size=5, padding=\"causal\", name=\"conv1d_k5\")(x)\n",
    "    branch_k7 = layers.Conv1D(d_model // 4, kernel_size=7, padding=\"causal\", name=\"conv1d_k7\")(x)\n",
    "\n",
    "    cnn_concat = layers.Concatenate(axis=-1, name=\"cnn_multiscale_concat\")([branch_k3, branch_k5, branch_k7])\n",
    "    cnn_act    = layers.Activation(\"gelu\", name=\"cnn_gelu\")(cnn_concat)\n",
    "    cnn_ln     = layers.LayerNormalization(epsilon=1e-6, name=\"cnn_ln\")(cnn_act)\n",
    "\n",
    "    linear_branch = layers.Dense(d_model // 4, activation=\"gelu\", name=\"linear_branch\")(x)\n",
    "\n",
    "    # 2. Feature Fusion Layer\n",
    "    fused = layers.Concatenate(axis=-1, name=\"parallel_fusion_concat\")([cnn_ln, linear_branch])\n",
    "    fused = layers.Dense(d_model, name=\"fusion_proj\")(fused)\n",
    "    fused = layers.LayerNormalization(epsilon=1e-6, name=\"fusion_ln\")(fused)\n",
    "\n",
    "    # 3. Positional Encoding + Pre-LN Transformer Encoder Stack + Final Pre-LN\n",
    "    h = SinusoidalPositionalEncoding(window_size, d_model, name=\"pos_encoding\")(fused)\n",
    "    for i in range(num_layers):\n",
    "        h = PreLNTransformerEncoderLayer(\n",
    "            d_model=d_model, num_heads=num_heads, ff_dim=ff_dim, dropout=dropout,\n",
    "            name=f\"encoder_layer_{i+1}\"\n",
    "        )(h)\n",
    "    h = layers.LayerNormalization(epsilon=1e-6, name=\"final_encoder_ln\")(h)\n",
    "\n",
    "    # 4. Last-Step Context Vector Readout với khởi tạo phương sai nhỏ khác 0\n",
    "    context_t = layers.Lambda(lambda z: z[:, -1, :], name=\"last_step_context\")(h)\n",
    "    head = layers.Dropout(dropout, name=\"head_dropout\")(context_t)\n",
    "    head = layers.Dense(32, activation=\"gelu\", kernel_regularizer=keras.regularizers.l2(1e-3), name=\"head_fc\")(head)\n",
    "    raw_out = layers.Dense(\n",
    "        1,\n",
    "        kernel_initializer=keras.initializers.RandomNormal(stddev=0.02, seed=42),\n",
    "        bias_initializer=\"zeros\",\n",
    "        name=\"raw_delta\"\n",
    "    )(head)\n",
    "    outputs = ShrinkageResidualScale(init_scale=init_scale, name=\"delta_scaled_pred\")(raw_out)\n",
    "\n",
    "    return keras.Model(inputs=inputs, outputs=outputs, name=\"OptimizedParallelFusionTransformer\")\n",
    "\n",
    "orig_sample = build_original_parallel_fusion_transformer(window_size=30, num_features=len(FEATURES_BASE_8))\n",
    "opt_sample  = build_optimized_parallel_fusion_transformer(window_size=30, num_features=len(FEATURES_BASE_8))\n",
    "print(f\"Original Model  : {orig_sample.name:36s} | Tổng số tham số: {orig_sample.count_params():,} (Trainable: {sum(np.prod(w.shape) for w in orig_sample.trainable_weights):,})\")\n",
    "print(f\"Optimized Model : {opt_sample.name:36s} | Tổng số tham số: {opt_sample.count_params():,} (Trainable: {sum(np.prod(w.shape) for w in opt_sample.trainable_weights):,})\")\n"
