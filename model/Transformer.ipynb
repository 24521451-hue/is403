    "# 1. Chia tập Test (804 phiên) thành 4 giai đoạn bằng nhau (mỗi giai đoạn 201 phiên) theo Mục 5 Phan_cong_mo_hinh.md\n",
    "n_test_total = len(test_sp_chk[\"dates\"])\n",
    "chunk_size = n_test_total // 4  # 201 phiên / giai đoạn\n",
    "\n",
    "regime_rows = []\n",
    "for idx in range(4):\n",
    "    s_i = idx * chunk_size\n",
    "    e_i = (idx + 1) * chunk_size if idx < 3 else n_test_total\n",
    "\n",
    "    dt_sub    = test_sp_chk[\"dates\"][s_i:e_i]\n",
    "    p_today   = test_sp_chk[\"price\"][s_i:e_i]\n",
    "    p_true    = test_sp_chk[\"next_price\"][s_i:e_i]\n",
    "    p_trans   = ens_pred_test[s_i:e_i]\n",
    "\n",
    "    m_naive = evaluate_predictions(p_true, p_today, p_today)\n",
    "    m_trans = evaluate_predictions(p_true, p_trans, p_today)\n",
    "\n",
    "    regime_rows.append({\n",
    "        \"Giai đoạn Test\": f\"GĐ {idx+1} ({dt_sub[0]} -> {dt_sub[-1]})\",\n",
    "        \"Số phiên\": len(dt_sub),\n",
    "        \"Giá TB ($)\": round(float(np.mean(p_true)), 2),\n",
    "        \"Std ΔPrice ($)\": round(float(np.std(p_true - p_today)), 4),\n",
    "        \"Naive_RMSE\": round(m_naive[\"RMSE\"], 4),\n",
    "        \"Trans_RMSE\": round(m_trans[\"RMSE\"], 4),\n",
    "        \"Naive_MAE\": round(m_naive[\"MAE\"], 4),\n",
    "        \"Trans_MAE\": round(m_trans[\"MAE\"], 4),\n",
    "        \"Trans_MAPE(%)\": round(m_trans[\"MAPE\"], 3),\n",
    "        \"Trans_DirAcc(%)\": round(m_trans[\"DirAcc\"], 2),\n",
    "        \"Trans_F1(%)\": round(m_trans[\"F1\"], 2)\n",
    "    })\n",
    "\n",
    "regime_df = pd.DataFrame(regime_rows)\n",
    "print(\"=== BẢNG 4: PHÂN TÍCH ĐỘ ỔN ĐỊNH QUA 4 GIAI ĐOẠN BẰNG NHAU CỦA TẬP TEST (201 PHIÊN / GIAI ĐOẠN) ===\")\n",
