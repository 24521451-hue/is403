    "class StationaryWindowNormalizer(layers.Layer):\n",
    "    \"\"\"\n",
    "    Reversible Instance Normalization (Kim et al., ICLR 2022) chuẩn hóa từng cửa sổ trượt\n",
    "    về mean = 0, std = 1 kèm tham số affine học được (gamma, beta) để chống dịch chuyển phân phối.\n",
    "    \"\"\"\n",
    "    def __init__(self, eps=1e-5, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.eps = eps\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        d = input_shape[-1]\n",
    "        self.gamma = self.add_weight(name=\"gamma\", shape=(1, 1, d), initializer=\"ones\", trainable=True)\n",
    "        self.beta  = self.add_weight(name=\"beta\",  shape=(1, 1, d), initializer=\"zeros\", trainable=True)\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        mean = tf.reduce_mean(x, axis=1, keepdims=True)\n",
    "        std  = tf.math.reduce_std(x, axis=1, keepdims=True) + self.eps\n",
    "        return ((x - mean) / std) * self.gamma + self.beta\n",
    "\n",
    "\n",
    "class SinusoidalPositionalEncoding(layers.Layer):\n",
    "    \"\"\"Mã hóa vị trí Sinusoidal chuẩn cho chuỗi thời gian.\"\"\"\n",
    "    def __init__(self, max_len, d_model, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        pos = np.arange(max_len)[:, np.newaxis]\n",
    "        div_term = np.exp(np.arange(0, d_model, 2) * -(np.log(10000.0) / d_model))\n",
    "        pe = np.zeros((max_len, d_model), dtype=np.float32)\n",
    "        pe[:, 0::2] = np.sin(pos * div_term)\n",
    "        pe[:, 1::2] = np.cos(pos * div_term[:pe[:, 1::2].shape[1]])\n",
    "        self.pe = tf.constant(pe[np.newaxis, :, :], dtype=tf.float32)\n",
    "\n",
    "    def call(self, x):\n",
    "        return x + self.pe[:, :tf.shape(x)[1], :]\n",
    "\n",
    "\n",
    "class PreLNTransformerEncoderLayer(layers.Layer):\n",
    "    \"\"\"Khối Pre-LayerNorm Transformer Encoder với mặt nạ nhân quả (Causal Self-Attention).\"\"\"\n",
    "    def __init__(self, d_model=64, num_heads=4, ff_dim=128, dropout=0.25, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.norm1 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.mha = layers.MultiHeadAttention(\n",
    "            num_heads=num_heads,\n",
    "            key_dim=max(1, d_model // num_heads),\n",
    "            dropout=dropout\n",
    "        )\n",
    "        self.drop1 = layers.Dropout(dropout)\n",
    "        self.norm2 = layers.LayerNormalization(epsilon=1e-6)\n",
    "        self.ffn = keras.Sequential([\n",
    "            layers.Dense(ff_dim, activation=\"gelu\"),\n",
    "            layers.Dropout(dropout),\n",
    "            layers.Dense(d_model)\n",
    "        ])\n",
    "        self.drop2 = layers.Dropout(dropout)\n",
    "\n",
    "    def call(self, x, training=False):\n",
    "        x_norm = self.norm1(x)\n",
    "        attn_out = self.mha(\n",
    "            query=x_norm, value=x_norm, key=x_norm,\n",
    "            use_causal_mask=True,\n",
    "            training=training\n",
    "        )\n",
    "        x = x + self.drop1(attn_out, training=training)\n",
    "        f_out = self.ffn(self.norm2(x), training=training)\n",
    "        return x + self.drop2(f_out, training=training)\n",
    "\n",
    "    def get_attention_scores(self, x):\n",
    "        x_norm = self.norm1(x)\n",
    "        _, scores = self.mha(\n",
    "            query=x_norm, value=x_norm, key=x_norm,\n",
    "            use_causal_mask=True,\n",
    "            return_attention_scores=True,\n",
    "            training=False\n",
    "        )\n",
    "        return scores\n",
    "\n",
    "\n",
    "class ShrinkageResidualScale(layers.Layer):\n",
    "    \"\"\"\n",
    "    Cổng điều tiết biên độ phần dư (Shrinkage Gate) khởi tạo gần mốc Martingale (delta = 0)\n",
    "    giúp ngăn chặn hiện tượng nổ phương sai dự đoán trên dữ liệu tài chính nhiều nhiễu.\n",
    "    \"\"\"\n",
    "    def __init__(self, init_scale=0.15, **kwargs):\n",
    "        super().__init__(**kwargs)\n",
    "        self.init_scale = init_scale\n",
    "\n",
    "    def build(self, input_shape):\n",
    "        self.alpha = self.add_weight(\n",
    "            name=\"shrinkage_alpha\",\n",
    "            shape=(1, 1),\n",
    "            initializer=keras.initializers.Constant(self.init_scale),\n",
    "            trainable=True\n",
    "        )\n",
    "        super().build(input_shape)\n",
    "\n",
    "    def call(self, x):\n",
    "        return x * tf.nn.tanh(self.alpha)\n",
    "\n",
    "\n",
    "def build_vanilla_transformer(\n",
    "    window_size=30,\n",
    "    num_features=8,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    ff_dim=128,\n",
    "    dropout=0.25,\n",
    "    use_revin=False\n",
    "):\n",
    "    \"\"\"Mô hình Transformer Encoder cơ sở (Baseline Deep Learning).\"\"\"\n",
    "    inputs = keras.Input(shape=(window_size, num_features), name=\"window_input\")\n",
    "    x = StationaryWindowNormalizer(name=\"revin_norm\")(inputs) if use_revin else inputs\n",
    "\n",
    "    x = layers.Dense(d_model, name=\"input_proj\")(x)\n",
    "    x = SinusoidalPositionalEncoding(window_size, d_model, name=\"pos_encoding\")(x)\n",
    "\n",
    "    for i in range(num_layers):\n",
    "        x = PreLNTransformerEncoderLayer(\n",
    "            d_model=d_model, num_heads=num_heads, ff_dim=ff_dim, dropout=dropout,\n",
    "            name=f\"encoder_layer_{i+1}\"\n",
    "        )(x)\n",
    "\n",
    "    context_t = layers.Lambda(lambda z: z[:, -1, :], name=\"last_step_context\")(x)\n",
    "    head = layers.Dropout(dropout, name=\"head_dropout\")(context_t)\n",
    "    head = layers.Dense(32, activation=\"gelu\", kernel_regularizer=keras.regularizers.l2(1e-3), name=\"head_fc\")(head)\n",
    "    if use_revin:\n",
    "        raw_out = layers.Dense(1, kernel_initializer=\"zeros\", name=\"raw_delta\")(head)\n",
    "        outputs = ShrinkageResidualScale(init_scale=0.15, name=\"delta_scaled_pred\")(raw_out)\n",
    "    else:\n",
    "        outputs = layers.Dense(1, name=\"delta_scaled_pred\")(head)\n",
    "\n",
    "    name = \"VanillaTransformer_RevIN\" if use_revin else \"VanillaTransformer\"\n",
    "    return keras.Model(inputs=inputs, outputs=outputs, name=name)\n",
    "\n",
    "\n",
    "def build_parallel_fusion_transformer(\n",
    "    window_size=30,\n",
    "    num_features=8,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    ff_dim=128,\n",
    "    dropout=0.25,\n",
    "    use_revin=True\n",
    "):\n",
    "    \"\"\"\n",
    "    Mô hình ParallelFusionTransformer (Liu, CMSDA 2025) kết hợp StationaryWindowNormalizer (RevIN):\n",
    "    - Front-End: 3 nhánh Conv1D đa tỷ lệ (k=3, 5, 7) + 1 nhánh Linear hợp nhất qua BatchNorm & LayerNorm.\n",
    "    - Back-End : Pre-LN Multi-Head Self-Attention Encoder + Last-Step Context Readout.\n",
    "    \"\"\"\n",
    "    inputs = keras.Input(shape=(window_size, num_features), name=\"window_input\")\n",
    "    x = StationaryWindowNormalizer(name=\"revin_norm\")(inputs) if use_revin else inputs\n",
    "\n",
    "    # 1. Parallel Multi-Scale Feature Extraction Front-End\n",
    "    branch_k3 = layers.Conv1D(d_model // 4, kernel_size=3, padding=\"causal\", name=\"conv1d_k3\")(x)\n",
    "    branch_k5 = layers.Conv1D(d_model // 4, kernel_size=5, padding=\"causal\", name=\"conv1d_k5\")(x)\n",
    "    branch_k7 = layers.Conv1D(d_model // 4, kernel_size=7, padding=\"causal\", name=\"conv1d_k7\")(x)\n",
    "\n",
    "    cnn_concat = layers.Concatenate(axis=-1, name=\"cnn_multiscale_concat\")([branch_k3, branch_k5, branch_k7])\n",
    "    cnn_act    = layers.Activation(\"gelu\", name=\"cnn_gelu\")(cnn_concat)\n",
    "    cnn_bn     = layers.BatchNormalization(name=\"cnn_bn\")(cnn_act)\n",
    "\n",
    "    linear_branch = layers.Dense(d_model // 4, activation=\"gelu\", name=\"linear_branch\")(x)\n",
    "\n",
    "    # 2. Feature Fusion Layer\n",
    "    fused = layers.Concatenate(axis=-1, name=\"parallel_fusion_concat\")([cnn_bn, linear_branch])\n",
    "    fused = layers.Dense(d_model, name=\"fusion_proj\")(fused)\n",
    "    fused = layers.LayerNormalization(epsilon=1e-6, name=\"fusion_ln\")(fused)\n",
    "\n",
    "    # 3. Positional Encoding + Transformer Encoder Stack\n",
    "    h = SinusoidalPositionalEncoding(window_size, d_model, name=\"pos_encoding\")(fused)\n",
    "    for i in range(num_layers):\n",
    "        h = PreLNTransformerEncoderLayer(\n",
    "            d_model=d_model, num_heads=num_heads, ff_dim=ff_dim, dropout=dropout,\n",
    "            name=f\"encoder_layer_{i+1}\"\n",
    "        )(h)\n",
    "\n",
    "    # 4. Last-Step Context Vector Readout\n",
    "    context_t = layers.Lambda(lambda z: z[:, -1, :], name=\"last_step_context\")(h)\n",
    "    head = layers.Dropout(dropout, name=\"head_dropout\")(context_t)\n",
    "    head = layers.Dense(32, activation=\"gelu\", kernel_regularizer=keras.regularizers.l2(1e-3), name=\"head_fc\")(head)\n",
    "    raw_out = layers.Dense(1, kernel_initializer=\"zeros\", name=\"raw_delta\")(head)\n",
    "    outputs = ShrinkageResidualScale(init_scale=0.15, name=\"delta_scaled_pred\")(raw_out)\n",
    "\n",
    "    return keras.Model(inputs=inputs, outputs=outputs, name=\"ParallelFusionTransformer\")\n",
    "\n",
    "sample_model = build_parallel_fusion_transformer(window_size=30, num_features=len(FEATURES_BASE_8))\n",
    "print(f\"Khởi tạo thành công {sample_model.name} | Tổng số tham số: {sample_model.count_params():,}\")"
   ]
