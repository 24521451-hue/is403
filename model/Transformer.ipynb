    "def evaluate_predictions(y_true, y_pred, y_today):\n",
    "    \"\"\"Tính bộ chỉ số đánh giá chuẩn theo Mục 6 của README.md trên giá thực USD.\"\"\"\n",
    "    mae  = float(mean_absolute_error(y_true, y_pred))\n",
    "    rmse = float(np.sqrt(mean_squared_error(y_true, y_pred)))\n",
    "    mape = float(np.mean(np.abs((y_true - y_pred) / y_true)) * 100.0)\n",
    "    r2   = float(r2_score(y_true, y_pred))\n",
    "\n",
    "    # Bài toán phân loại xu hướng tăng/giảm (Mục 6.2 README.md & Liu 2025)\n",
    "    dir_true = (y_true > y_today).astype(int)\n",
    "    dir_pred = (y_pred > y_today).astype(int)\n",
    "    dir_acc  = float(np.mean(dir_true == dir_pred) * 100.0)\n",
    "    f1       = float(f1_score(dir_true, dir_pred, zero_division=0) * 100.0)\n",
    "    mcc      = float(matthews_corrcoef(dir_true, dir_pred))\n",
    "    return {\n",
    "        \"MAE\": mae, \"RMSE\": rmse, \"MAPE\": mape, \"R2\": r2,\n",
    "        \"DirAcc\": dir_acc, \"F1\": f1, \"MCC\": mcc\n",
    "    }\n",
    "\n",
    "\n",
    "def train_and_evaluate_transformer(\n",
    "    feature_cols,\n",
    "    arch=\"parallel_fusion\",\n",
    "    use_revin=True,\n",
    "    window=30,\n",
    "    d_model=64,\n",
    "    num_heads=4,\n",
    "    num_layers=2,\n",
    "    dropout=0.25,\n",
    "    lr=5e-4,\n",
    "    batch_size=64,\n",
    "    epochs=55,\n",
    "    patience=15,\n",
    "    seed=42,\n",
    "    calibrate_shrinkage=True\n",
    "):\n",
    "    \"\"\"\n",
    "    Huấn luyện mô hình trên train_fit, dừng sớm theo val_loss trên train_val,\n",
    "    inverse_transform delta dự đoán và khôi phục về giá USD (nextPrice_pred = Price + delta_pred).\n",
    "    \"\"\"\n",
    "    set_all_seeds(seed)\n",
    "    fit_sp, val_sp, test_sp, x_scaler, y_scaler = prepare_window_data(df, feature_cols, window=window)\n",
    "\n",
    "    if arch == \"vanilla\":\n",
    "        model = build_vanilla_transformer(\n",
    "            window_size=window, num_features=len(feature_cols),\n",
    "            d_model=d_model, num_heads=num_heads, num_layers=num_layers,\n",
    "            ff_dim=d_model * 2, dropout=dropout, use_revin=use_revin\n",
    "        )\n",
    "    else:\n",
    "        model = build_parallel_fusion_transformer(\n",
    "            window_size=window, num_features=len(feature_cols),\n",
    "            d_model=d_model, num_heads=num_heads, num_layers=num_layers,\n",
    "            ff_dim=d_model * 2, dropout=dropout, use_revin=use_revin\n",
    "        )\n",
    "\n",
    "    optimizer = keras.optimizers.AdamW(learning_rate=lr, weight_decay=1e-3, clipnorm=1.0)\n",
    "    model.compile(optimizer=optimizer, loss=keras.losses.Huber(delta=1.0))\n",
    "\n",
    "    callbacks = [\n",
    "        keras.callbacks.EarlyStopping(monitor=\"val_loss\", patience=patience, restore_best_weights=True),\n",
    "        keras.callbacks.ReduceLROnPlateau(monitor=\"val_loss\", factor=0.5, patience=5, min_lr=1e-5)\n",
    "    ]\n",
    "\n",
    "    t0 = time.time()\n",
    "    history = model.fit(\n",
    "        fit_sp[\"X\"], fit_sp[\"y_scaled\"],\n",
    "        validation_data=(val_sp[\"X\"], val_sp[\"y_scaled\"]),\n",
    "        epochs=epochs,\n",
    "        batch_size=batch_size,\n",
    "        shuffle=False,  # Tuyệt đối không shuffle chuỗi thời gian theo quy ước nhóm\n",
    "        callbacks=callbacks,\n",
    "        verbose=0\n",
    "    )\n",
    "    train_time = time.time() - t0\n",
    "\n",
    "    # Dự đoán trên miền đã scale và inverse_transform về USD\n",
    "    raw_val_delta  = y_scaler.inverse_transform(model.predict(val_sp[\"X\"], verbose=0)).flatten()\n",
    "    raw_test_delta = y_scaler.inverse_transform(model.predict(test_sp[\"X\"], verbose=0)).flatten()\n",
    "\n",
    "    # Hiệu chỉnh hệ số co giãn dương alpha* chỉ dựa trên tập train_val (giữ nguyên 100% dấu dự đoán)\n",
    "    alpha_opt = 1.0\n",
    "    if calibrate_shrinkage:\n",
    "        cov = float(np.mean(raw_val_delta * val_sp[\"y_delta\"]))\n",
    "        var = float(np.mean(raw_val_delta ** 2)) + 1e-12\n",
    "        alpha_opt = float(np.clip(cov / var, 0.15, 1.0))\n",
    "\n",
    "    pred_delta_val  = alpha_opt * raw_val_delta\n",
    "    pred_delta_test = alpha_opt * raw_test_delta\n",
    "\n",
    "    pred_price_val  = val_sp[\"price\"] + pred_delta_val\n",
    "    pred_price_test = test_sp[\"price\"] + pred_delta_test\n",
    "\n",
    "    return {\n",
    "        \"model\": model,\n",
    "        \"history\": history.history,\n",
    "        \"params\": int(model.count_params()),\n",
    "        \"train_time\": round(train_time, 2),\n",
    "        \"best_epoch\": int(np.argmin(history.history[\"val_loss\"]) + 1),\n",
    "        \"alpha_opt\": round(alpha_opt, 4),\n",
    "        \"val_metrics\": evaluate_predictions(val_sp[\"next_price\"], pred_price_val, val_sp[\"price\"]),\n",
    "        \"test_metrics\": evaluate_predictions(test_sp[\"next_price\"], pred_price_test, test_sp[\"price\"]),\n",
    "        \"pred_price_val\": pred_price_val,\n",
    "        \"pred_price_test\": pred_price_test,\n",
    "        \"pred_delta_val\": pred_delta_val,\n",
    "        \"pred_delta_test\": pred_delta_test,\n",
    "        \"val_sp\": val_sp,\n",
    "        \"test_sp\": test_sp\n",
    "    }\n",
    "\n",
    "# Tính mốc tham chiếu Naive Baseline (nextPrice_pred = Price_t <=> delta_pred = 0)\n",
    "naive_val_metrics  = evaluate_predictions(val_sp_chk[\"next_price\"],  val_sp_chk[\"price\"],  val_sp_chk[\"price\"])\n",
    "naive_test_metrics = evaluate_predictions(test_sp_chk[\"next_price\"], test_sp_chk[\"price\"], test_sp_chk[\"price\"])\n",
    "\n",
    "# Chạy thực nghiệm đối chứng (Ablation Study) với Seed = 42\n",
    "exp_vanilla_no_revin = train_and_evaluate_transformer(\n",
    "    FEATURES_BASE_8, arch=\"vanilla\", use_revin=False, calibrate_shrinkage=False, seed=42\n",
    ")\n",
    "exp_vanilla_revin = train_and_evaluate_transformer(\n",
    "    FEATURES_BASE_8, arch=\"vanilla\", use_revin=True, calibrate_shrinkage=True, seed=42\n",
    ")\n",
    "exp_fusion_ext12 = train_and_evaluate_transformer(\n",
    "    FEATURES_EXT_12, arch=\"parallel_fusion\", use_revin=True, calibrate_shrinkage=True, seed=42\n",
    ")\n",
    "exp_fusion_ext11 = train_and_evaluate_transformer(\n",
    "    FEATURES_EXT_11, arch=\"parallel_fusion\", use_revin=True, calibrate_shrinkage=True, seed=42\n",
    ")\n",
    "exp_fusion_base8 = train_and_evaluate_transformer(\n",
    "    FEATURES_BASE_8, arch=\"parallel_fusion\", use_revin=True, calibrate_shrinkage=True, seed=42\n",
    ")\n",
    "\n",
    "ablation_configs = [\n",
    "    (\"0. Naive Baseline (delta = 0)\", \"-\", naive_val_metrics, naive_test_metrics, 0, 0.0),\n",
    "    (\"1. Vanilla Transformer (No RevIN)\", \"Cơ sở (8 cột)\", exp_vanilla_no_revin[\"val_metrics\"], exp_vanilla_no_revin[\"test_metrics\"], exp_vanilla_no_revin[\"params\"], exp_vanilla_no_revin[\"train_time\"]),\n",
    "    (\"2. Vanilla Transformer + RevIN\", \"Cơ sở (8 cột)\", exp_vanilla_revin[\"val_metrics\"], exp_vanilla_revin[\"test_metrics\"], exp_vanilla_revin[\"params\"], exp_vanilla_revin[\"train_time\"]),\n",
    "    (\"3. ParallelFusionTransformer + RevIN\", \"Mở rộng (12 cột, có Year)\", exp_fusion_ext12[\"val_metrics\"], exp_fusion_ext12[\"test_metrics\"], exp_fusion_ext12[\"params\"], exp_fusion_ext12[\"train_time\"]),\n",
    "    (\"4. ParallelFusionTransformer + RevIN\", \"Mở rộng (11 cột, bỏ Year)\", exp_fusion_ext11[\"val_metrics\"], exp_fusion_ext11[\"test_metrics\"], exp_fusion_ext11[\"params\"], exp_fusion_ext11[\"train_time\"]),\n",
    "    (\"5. ParallelFusionTransformer + RevIN\", \"Cơ sở (8 cột chuẩn nhóm)\", exp_fusion_base8[\"val_metrics\"], exp_fusion_base8[\"test_metrics\"], exp_fusion_base8[\"params\"], exp_fusion_base8[\"train_time\"]),\n",
    "]\n",
    "\n",
    "ablation_rows = []\n",
    "for name, feat_name, vm, tm, n_params, t_sec in ablation_configs:\n",
    "    ablation_rows.append({\n",
    "        \"Mô hình / Cấu hình\": name,\n",
    "        \"Bộ Feature\": feat_name,\n",
    "        \"Val_MAE\": round(vm[\"MAE\"], 4),\n",
    "        \"Val_RMSE\": round(vm[\"RMSE\"], 4),\n",
    "        \"Test_MAE\": round(tm[\"MAE\"], 4),\n",
    "        \"Test_RMSE\": round(tm[\"RMSE\"], 4),\n",
    "        \"Test_MAPE(%)\": round(tm[\"MAPE\"], 3),\n",
    "        \"Test_R2\": round(tm[\"R2\"], 4),\n",
    "        \"Test_DirAcc(%)\": round(tm[\"DirAcc\"], 2),\n",
    "        \"Test_F1(%)\": round(tm[\"F1\"], 2),\n",
    "        \"Test_MCC\": round(tm[\"MCC\"], 4),\n",
    "        \"Params\": n_params,\n",
    "        \"Time(s)\": t_sec\n",
    "    })\n",
    "\n",
    "ablation_df = pd.DataFrame(ablation_rows)\n",
    "print(\"=== BẢNG 1: KẾT QUẢ ABLATION STUDY (KIẾN TRÚC & BỘ ĐẶC TRƯNG, SEED = 42) ===\")\n",
    "print(ablation_df.to_string(index=False))"
   ]
