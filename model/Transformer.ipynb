    "# Xác định đường dẫn thư mục model_predict\n",
    "predict_dir = os.path.join(\"..\", \"model_predict\") if os.path.exists(\"..\") and os.path.basename(os.getcwd()) == \"model\" else \"model_predict\"\n",
    "os.makedirs(predict_dir, exist_ok=True)\n",
    "\n",
    "# 1. Dự báo biến động giá trên toàn bộ dataset (4.020 dòng) qua 3-Seed Ensemble\n",
    "X_scaled_all = x_sc_chk.transform(df[FEATURES_BASE_8].values)\n",
    "padded_X = np.pad(X_scaled_all, ((30 - 1, 0), (0, 0)), mode=\"edge\")\n",
    "X_all = np.array([padded_X[i : i + 30] for i in range(len(df))], dtype=np.float32)\n",
    "\n",
    "all_pred_deltas = []\n",
    "for r in seed_runs:\n",
    "    raw_delta_all = y_sc_chk.inverse_transform(r[\"model\"].predict(X_all, verbose=0)).flatten()\n",
    "    pred_delta_all = r[\"alpha_opt\"] * raw_delta_all\n",
    "    all_pred_deltas.append(pred_delta_all)\n",
    "\n",
    "ens_delta_all = np.mean(all_pred_deltas, axis=0)\n",
    "\n",
    "# Khôi phục giá dự báo trên toàn bộ dataset\n",
    "pred_all = df[\"Price\"].values + ens_delta_all\n",
    "\n",
    "# Tạo DataFrame kết quả dự báo trên toàn bộ dataset (4.020 dòng)\n",
    "pred_full_df = pd.DataFrame({\n",
    "    \"Date\": df[\"Date\"].dt.strftime(\"%Y-%m-%d\") if hasattr(df[\"Date\"].iloc[0], \"strftime\") else df[\"Date\"].values,\n",
    "    \"price_pred\": np.round(pred_all, 4)\n",
    "})\n",
    "\n",
    "# Xuất duy nhất 1 file CSV vào thư mục model_predict\n",
    "output_csv_path = os.path.join(predict_dir, \"pred_Transformer.csv\")\n",
    "pred_full_df.to_csv(output_csv_path, index=False)\n",
    "\n",
    "# Kiểm định tính toàn vẹn của file CSV đã xuất\n",
    "assert len(pred_full_df) == 4020, f\"Expected 4020 rows, got {len(pred_full_df)}\"\n",
