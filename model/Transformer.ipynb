   "source": [
    "# Bộ 8 đặc trưng cơ sở chuẩn theo thiết kế dự án (Mục 2.3 & Mục 4 README.md)\n",
    "# 5 cột đầu là đặc trưng mức giá/khối lượng không dừng; 3 cột cuối là đặc trưng biến động dừng quanh gốc 0\n",
    "FEATURES_BASE_8 = [\n",
    "    \"Price\", \"Open\", \"High\", \"Low\", \"Volume\",\n",
    "    \"Return_1\", \"High_Low_Range\", \"Open_Close_Change\"\n",
    "]\n",
    "\n",
    "def prepare_window_data(df_all, feature_cols=FEATURES_BASE_8, window=30):\n",
    "    \"\"\"\n",
    "    Chuẩn hóa đặc trưng X và mục tiêu delta bằng StandardScaler (chỉ fit trên train_fit)\n",
    "    và tạo cửa sổ trượt 3D (samples, window, features) bảo toàn 100% biên thời gian.\n",
    "    \"\"\"\n",
    "    fit_df = df_all.iloc[:n_fit]\n",
    "\n",
    "    x_scaler = StandardScaler()\n",
    "    y_scaler = StandardScaler()\n",
    "\n",
    "    x_scaler.fit(fit_df[feature_cols].values)\n",
    "    y_scaler.fit(fit_df[[\"delta\"]].values)\n",
    "\n",
    "    X_scaled = x_scaler.transform(df_all[feature_cols].values)\n",
    "    y_scaled = y_scaler.transform(df_all[[\"delta\"]].values).flatten()\n",
    "\n",
    "    y_raw_delta = df_all[\"delta\"].values\n",
    "    prices      = df_all[\"Price\"].values\n",
    "    next_prices = df_all[\"nextPrice\"].values\n",
    "    dates       = df_all[\"Date\"].dt.strftime(\"%Y-%m-%d\").values\n",
    "\n",
    "    def build_split(start_idx, end_idx):\n",
    "        X_w, y_s, y_d, p_cur, p_next, dt = [], [], [], [], [], []\n",
    "        for i in range(start_idx, end_idx):\n",
    "            if i < window - 1:\n",
    "                continue\n",
    "            X_w.append(X_scaled[i - window + 1 : i + 1])\n",
    "            y_s.append(y_scaled[i])\n",
    "            y_d.append(y_raw_delta[i])\n",
    "            p_cur.append(prices[i])\n",
    "            p_next.append(next_prices[i])\n",
    "            dt.append(dates[i])\n",
    "        return {\n",
    "            \"X\": np.array(X_w, dtype=np.float32),\n",
    "            \"y_scaled\": np.array(y_s, dtype=np.float32),\n",
    "            \"y_delta\": np.array(y_d, dtype=np.float64),\n",
    "            \"price\": np.array(p_cur, dtype=np.float64),\n",
    "            \"next_price\": np.array(p_next, dtype=np.float64),\n",
    "            \"dates\": np.array(dt)\n",
    "        }\n",
    "\n",
    "    fit_split  = build_split(window - 1, n_fit)\n",
    "    val_split  = build_split(n_fit, n_train)\n",
    "    test_split = build_split(n_train, len(df_all))\n",
    "    return fit_split, val_split, test_split, x_scaler, y_scaler\n",
    "\n",
    "# Kiểm tra kích thước tensor trên bộ 8 đặc trưng cơ sở chuẩn với WINDOW = 30\n",
    "fit_sp_chk, val_sp_chk, test_sp_chk, x_sc_chk, y_sc_chk = prepare_window_data(df, FEATURES_BASE_8, window=30)\n",
    "print(f\"Bộ đặc trưng cơ sở chuẩn (8 cột) : {FEATURES_BASE_8}\")\n",
    "print(f\"y_scaler (fit trên train_fit)    : mean = {y_sc_chk.mean_[0]:.4f} USD | std = {y_sc_chk.scale_[0]:.4f} USD\")\n",
    "print(f\"X_fit shape                      : {fit_sp_chk['X'].shape} | y_fit shape  : {fit_sp_chk['y_scaled'].shape} ({fit_sp_chk['dates'][0]} -> {fit_sp_chk['dates'][-1]})\")\n",
    "print(f\"X_val shape                      : {val_sp_chk['X'].shape}  | y_val shape  : {val_sp_chk['y_scaled'].shape}  ({val_sp_chk['dates'][0]} -> {val_sp_chk['dates'][-1]})\")\n",
    "print(f\"X_test shape                     : {test_sp_chk['X'].shape}  | y_test shape : {test_sp_chk['y_scaled'].shape}  ({test_sp_chk['dates'][0]} -> {test_sp_chk['dates'][-1]})\")\n"
   ]
