    "axes[0].plot(train_fit_df[\"Date\"], train_fit_df[\"Price\"], label=\"train_fit (2010–03/2022, n=2894)\", color=\"#1d4ed8\", lw=1.3)\n",
    "axes[0].plot(train_val_df[\"Date\"], train_val_df[\"Price\"], label=\"train_val (04/2022–07/2023, n=322)\", color=\"#d97706\", lw=1.5)\n",
    "axes[0].plot(test_df[\"Date\"], test_df[\"Price\"], label=\"test (07/2023–09/2026, n=804)\", color=\"#15803d\", lw=1.5)\n",
    "axes[0].axhline(train_df[\"Price\"].max(), color=\"#dc2626\", ls=\"--\", lw=1.0, label=\"Đỉnh tập Train ($193.97)\")\n",
    "axes[0].set_title(\"1. Dịch chuyển mặt bằng giá AAPL (Non-Stationarity)\", fontsize=10.5, fontweight=\"bold\")\n",
