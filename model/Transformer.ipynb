    "axes[2].hist(train_fit_df[\"delta\"], bins=60, density=True, alpha=0.6, color=\"#1d4ed8\", label=\"train_fit ΔPrice\")\n",
    "axes[2].hist(test_df[\"delta\"], bins=60, density=True, alpha=0.5, color=\"#15803d\", label=\"test ΔPrice\")\n",
